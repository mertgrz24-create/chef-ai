{
  "name": "chef-ai-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:security": "node --test --test-timeout=10000 lib/mobile/security.test.cjs",
    "postinstall": "node lib/mobile/apply-dependency-patches.cjs",
    "env:check": "node lib/mobile/local-environment.cjs",
    "test:database": "node lib/mobile/verify-database.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@google/generative-ai": "^0.24.1",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.105.1",
    "framer-motion": "^12.42.2",
    "nanoid": "^3.3.15",
    "next": "^16.2.10",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.10",
    "postcss": "^8.5.10",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "@tailwindcss/postcss": "4.3.3"
  },
  "overrides": {
    "postcss": "$postcss",
    "postcss-selector-parser": "7.1.6",
    "@next/eslint-plugin-next": {
      "fast-glob": "npm:tinyglobby@0.2.17"
    },
    "uri-js": "npm:fast-uri@4.2.2",
    "zod": "4.6.7"
