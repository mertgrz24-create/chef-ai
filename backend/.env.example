NEXT_PUBLIC_SUPABASE_URL=https://vcyqtbzhfanbpclfhibv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Optional explicit model. Staging acceptance uses gemini-3.5-flash-lite.
GEMINI_MODEL=
# Staging-only: at most one additional call after an explicit provider 503.
GEMINI_RETRY_503=false
PEXELS_API_KEY=
CRON_SECRET=          # protects /api/push/send-expiry-alerts; Vercel Cron sends it as a bearer token

# Optional store links on the retained public recipe page; blank until published.
NEXT_PUBLIC_IOS_APP_URL=
NEXT_PUBLIC_ANDROID_APP_URL=

# Mobile API release configuration. Keep all readiness flags false until staging evidence passes.
MOBILE_MINIMUM_VERSION=1.0.0
MOBILE_MAINTENANCE=false
MOBILE_PRIVACY_URL=
MOBILE_TERMS_URL=
MOBILE_SUPPORT_URL=
MOBILE_DELETION_URL=
MOBILE_AI_CONSENT_VERSION=
MOBILE_AI_RETENTION_EN=
MOBILE_AI_RETENTION_TR=
MOBILE_AI_READY=false
MOBILE_LOCALIZED_AI_READY=false
MOBILE_PUSH_READY=false
# Owner-approved finite monthly free scan/plan caps and global daily AI attempt budget.
# Recipes are capped at 10/month. Never expose these as client-writable settings.
MOBILE_FREE_SCAN_LIMIT=
MOBILE_FREE_PLAN_LIMIT=
MOBILE_AI_DAILY_ATTEMPT_LIMIT=

MOBILE_REPORT_RETENTION_DAYS=
EXPO_ACCESS_TOKEN=

# RevenueCat server-only credentials; configure matching project, monthly products,
# entitlement and Keep-with-original-owner restore behavior before enabling.
MOBILE_ENVIRONMENT=staging
MOBILE_BILLING_READY=false
REVENUECAT_SECRET_KEY=
REVENUECAT_ENTITLEMENT_ID=
REVENUECAT_IOS_MONTHLY_PRODUCT=
REVENUECAT_ANDROID_MONTHLY_PRODUCT=
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_WEBHOOK_SIGNING_SECRET=
MOBILE_PREMIUM_RECIPE_LIMIT=
MOBILE_PREMIUM_SCAN_LIMIT=
MOBILE_PREMIUM_PLAN_LIMIT=

MOBILE_ANALYTICS_READY=false
MOBILE_APP_VERSION=1.0.0
