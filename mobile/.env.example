# Supabase — use the matching API environment; preview must use chef-ai-staging
# Staging URL: https://vcyqtbzhfanbpclfhibv.supabase.co
EXPO_PUBLIC_SUPABASE_URL=https://vcyqtbzhfanbpclfhibv.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Next.js API base (AI endpoints live here; keys never ship to the device)
# Local dev:  http://localhost:3000
# Production: configure the verified backend API origin; never use the marketing site by assumption.
EXPO_PUBLIC_API_URL=https://chef-ai-staging-nu.vercel.app

# development | staging | production. Preview must use a separate staging API.
EXPO_PUBLIC_APP_ENV=staging
# HTTPS origin with /auth/callback + .well-known associations served by the web owner.
EXPO_PUBLIC_EAS_PROJECT_ID=
EXPO_PUBLIC_AUTH_ORIGIN=
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# Build-time only (never EXPO_PUBLIC): SENTRY_AUTH_TOKEN, SENTRY_ORG, SENTRY_PROJECT
# EAS: EXPO_TOKEN, APPLE/GOOGLE credentials in managed secret storage.
