{
  "expo": {
    "name": "Chef-AI",
    "slug": "chef-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "chefai",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.chefai.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Chef-AI uses your camera to identify ingredients from a photo of your fridge.",
        "NSPhotoLibraryUsageDescription": "Chef-AI reads photos you choose so it can identify your ingredients."
      }
    },
    "android": {
      "package": "com.chefai.app",
      "adaptiveIcon": {
        "backgroundColor": "#1E3A2F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.CAMERA", "android.permission.READ_MEDIA_IMAGES"]
    },
    "web": {
      "output": "static",
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1E3A2F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Chef-AI reads photos you choose so it can identify your ingredients.",
          "cameraPermission": "Chef-AI uses your camera to identify ingredients from a photo of your fridge."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1E3A2F"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
