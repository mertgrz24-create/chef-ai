{
  "expo": {
    "name": "Chef-AI",
    "slug": "chef-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "chefai",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.chefai.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Chef-AI uses your camera to identify ingredients from a photo of your fridge.",
        "NSPhotoLibraryUsageDescription": "Chef-AI reads photos you choose so it can identify your ingredients.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.chefai.app",
      "adaptiveIcon": {
        "backgroundColor": "#1E3A2F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "allowBackup": false
    },
    "web": {
      "output": "static",
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1E3A2F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Chef-AI reads photos you choose so it can identify your ingredients.",
          "cameraPermission": "Chef-AI uses your camera to identify ingredients from a photo of your fridge.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1E3A2F"
        }
      ],
      "expo-localization",
      [
        "@sentry/react-native/expo",
        {}
      ],
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "./plugins/with-android-compat.cjs"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "updates": {
      "enabled": false
    },
    "locales": {
      "tr": "./locales/tr.json",
      "en": "./locales/en.json"
    }
  }
}
